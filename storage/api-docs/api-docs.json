{
    "openapi": "3.0.0",
    "info": {
        "title": "Catalog API",
        "description": "JSON API for catalog search and categories.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Current application host"
        }
    ],
    "paths": {
        "/api/catalog/categories": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "operationId": "catalogCategoriesRoot",
                "responses": {
                    "200": {
                        "description": "Root categories",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "data"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CategoryNode"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/catalog/categories/{id}": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "operationId": "catalogCategoryShow",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Child categories and breadcrumb for a category",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "data",
                                        "meta"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CategoryNode"
                                            }
                                        },
                                        "meta": {
                                            "required": [
                                                "parent",
                                                "breadcrumb"
                                            ],
                                            "properties": {
                                                "parent": {
                                                    "oneOf": [
                                                        {
                                                            "$ref": "#/components/schemas/CategoryNode"
                                                        }
                                                    ],
                                                    "nullable": true
                                                },
                                                "breadcrumb": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/CategoryNode"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Category not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/catalog/categories/{category}/products": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "operationId": "catalogCategoryProducts",
                "parameters": [
                    {
                        "name": "category",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated products in category",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "data",
                                        "meta"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CatalogProduct"
                                            }
                                        },
                                        "meta": {
                                            "required": [
                                                "current_page",
                                                "per_page",
                                                "has_more"
                                            ],
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer"
                                                },
                                                "per_page": {
                                                    "type": "integer"
                                                },
                                                "has_more": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Category not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/catalog/search": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "operationId": "catalogSearch",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "maxLength": 100
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 20,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Search hits or empty list when query is missing or shorter than 2 characters",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "data",
                                        "meta"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CatalogProduct"
                                            }
                                        },
                                        "meta": {
                                            "required": [
                                                "limit",
                                                "query"
                                            ],
                                            "properties": {
                                                "limit": {
                                                    "type": "integer"
                                                },
                                                "query": {
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ApiError": {
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string",
                        "nullable": true
                    },
                    "errors": {
                        "description": "Validation errors keyed by field name",
                        "type": "object",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "CatalogProduct": {
                "required": [
                    "id",
                    "title"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 100
                    },
                    "title": {
                        "type": "string",
                        "example": "Product"
                    },
                    "price": {
                        "description": "Numeric price or string from upstream catalog",
                        "nullable": true,
                        "oneOf": [
                            {
                                "type": "number",
                                "format": "float"
                            },
                            {
                                "type": "string"
                            }
                        ]
                    },
                    "image_url": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "CategoryNode": {
                "required": [
                    "id",
                    "title"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Electronics"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Catalog",
            "description": "Catalog endpoints"
        }
    ]
}